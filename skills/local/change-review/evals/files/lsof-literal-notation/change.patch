+
+# Escapes a cwd for the one-line output; see the header.
+encode_cwd() {
+  local LC_ALL=C cwd="$1" out="" c i
+  if [[ "${cwd}" != *[[:cntrl:]\\]* ]]; then
+    printf '%s' "${cwd}"
+    return
+  fi
+  for ((i = 0; i < ${#cwd}; i++)); do
+    c="${cwd:i:1}"
+    case "${c}" in
+      $'\n') out+='\n' ;;
+      $'\t') out+='\t' ;;
+      \\) out+='\\' ;;
+      [[:cntrl:]]) out+="$(printf '\\x%02x' "'${c}")" ;;
+      *) out+="${c}" ;;
+    esac
+  done
+  printf '%s' "${out}"
+}
