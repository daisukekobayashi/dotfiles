#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

case "$(uname -s 2>/dev/null || printf unknown)" in
  MINGW* | MSYS* | CYGWIN*)
    if command -v pwsh >/dev/null 2>&1; then
      pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-skills-build.ps1
    elif command -v powershell >/dev/null 2>&1; then
      powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-skills-build.ps1
    else
      scripts/check-skills-build.sh
    fi
    ;;
  *)
    scripts/check-skills-build.sh
    ;;
esac

# Codex and Claude rewrite their settings copies; mention local edits without blocking.
if command -v node >/dev/null 2>&1 && [ -d setup/node_modules/smol-toml ]; then
  node setup/managed-copy.js diff --summary || true
fi
