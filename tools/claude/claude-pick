#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: claude-pick [--env ENV] [-m MODEL] [-e EFFORT] [MODEL [EFFORT]] [-- CLAUDE_ARGS...]

Create or refresh environments with: ./setup.sh claude --env NAME

Without arguments, choose an environment with fzf and use its saved model/effort.
An explicit environment alone launches without a picker.
With a model or effort specified, choose the missing one interactively.
Use "keep" for model/effort to leave Claude's configuration in control.
Effort choices: keep, low, medium, high, xhigh, max (support varies by model).

"default" uses ~/.claude; named environments use ~/.claude-envs/NAME.
Legacy -p/--profile remain aliases for --env.
Legacy --create-env/--create [--skill NAME ...] delegate to setup (creation only).
Names: 1-64 lowercase letters, digits, hyphens, underscores; start with a letter.
Arguments after -- are forwarded unchanged, including Claude's -p/--print.
Auth and maintenance subcommands skip model/effort selection.
EOF
}

die() { printf 'claude-pick: %s\n' "$2" >&2; exit "$1"; }
require_command() { command -v "$1" >/dev/null 2>&1 || die 127 "Required command not found: $1"; }

# Resolve installed symlinks without GNU readlink -f (macOS ships Bash 3.2).
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
dotfiles_root="$(cd "$(dirname "$script_path")/../.." && pwd -P)"
envs_root="${HOME}/.claude-envs"

valid_name() {
  [[ "$1" =~ ^[a-z][a-z0-9_-]{0,63}$ ]] || return 1
  case "$1" in default|con|prn|aux|nul|com[0-9]|lpt[0-9]) return 1 ;; esac
}

validate_name() { valid_name "$1" || die 2 "Invalid or reserved environment name: $1"; }

env_ready() {
  [[ -d "$1" && ! -L "$1" && -f "$1/.claude-pick" && -f "$1/settings.json" ]] &&
    [[ "$(cat "$1/.claude-pick")" = 1 ]]
}

check_environment() {
  [[ "$env_name" = default ]] && return 0
  local key pattern
  local -a conflicts=()
  while IFS= read -r key; do
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    [[ -n "${!key:-}" ]] || continue
    while IFS= read -r pattern; do
      # Patterns are repository-owned environment-variable globs, not values.
      # shellcheck disable=SC2053
      if [[ "$key" = $pattern ]]; then
        conflicts+=("$key")
        break
      fi
    done < "$dotfiles_root/tools/claude/auth-env.txt"
  done < <(compgen -e)
  if [[ ${#conflicts[@]} -gt 0 ]]; then
    die 2 "Named environment blocked by inherited credentials or routes: ${conflicts[*]}. Unset these in this shell, or use default. Values are not displayed."
  fi
}

pick() {
  local prompt="$1" rows="$2" selected choice
  [[ -t 0 && -t 2 ]] || die 2 "Interactive selection needs a terminal. Specify --env, --model and --effort (or keep)."
  require_command fzf
  selected="$(printf '%s\n' "$rows" | fzf --delimiter=$'\t' --with-nth=1,2 --prompt="$prompt> ")" || exit $?
  [[ -n "$selected" ]] || exit 130
  choice="${selected%%$'\t'*}"
  while IFS=$'\t' read -r key _; do
    if [[ "$choice" = "$key" ]]; then printf '%s\n' "$choice"; return; fi
  done <<< "$rows"
  die 2 "Invalid picker selection"
}

env_rows() {
  local candidate name
  printf 'default\tStandard environment (~/.claude)\n'
  for candidate in "$envs_root"/*; do
    name="${candidate##*/}"
    if valid_name "$name" && env_ready "$candidate"; then printf '%s\tNamed environment\n' "$name"; fi
  done
}

env_name="" model="" effort="" create_name=""
skills=() positional=() claude_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --env|-p|--profile|-m|--model|-e|--effort|--create-env|--create|--skill)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die 2 "$1 requires a value"
      case "$1" in
        --env|-p|--profile)
          [[ -z "$env_name" || "$env_name" = "$2" ]] || die 2 "Environment specified twice with different names"
          env_name="$2" ;;
        -m|--model) model="$2" ;;
        -e|--effort) effort="$2" ;;
        --create-env|--create) create_name="$2" ;;
        --skill) skills+=("$2") ;;
      esac
      shift 2 ;;
    --env=*)
      value="${1#--env=}"
      [[ -n "$value" ]] || die 2 "--env requires a value"
      [[ -z "$env_name" || "$env_name" = "$value" ]] || die 2 "Environment specified twice with different names"
      env_name="$value"; shift ;;
    --) shift; claude_args=("$@"); break ;;
    -*) die 2 "Unknown option: $1. Put Claude arguments after --" ;;
    *) positional+=("$1"); shift ;;
  esac
done
[[ ${#positional[@]} -le 2 ]] || die 2 "Too many arguments. Put Claude arguments after --"
if [[ ${#positional[@]} -gt 0 ]]; then
  [[ -z "$model" ]] || die 2 "Model specified twice"
  model="${positional[0]}"
fi
if [[ ${#positional[@]} -gt 1 ]]; then
  [[ -z "$effort" ]] || die 2 "Effort specified twice"
  effort="${positional[1]}"
fi
if [[ -n "$create_name" ]]; then
  [[ -z "$env_name$model$effort" && ${#claude_args[@]} -eq 0 ]] || die 2 "--create-env cannot be combined with launch arguments"
  validate_name "$create_name"
  [[ ! -e "$envs_root/$create_name" && ! -L "$envs_root/$create_name" ]] || die 2 "Environment already exists: $create_name"
  printf 'claude-pick: Use setup.sh claude --env NAME for environment creation. Delegating to setup.\n' >&2
  setup_args=(--env "$create_name")
  for skill in ${skills[@]+"${skills[@]}"}; do setup_args+=(--skill "$skill"); done
  exec env SETUP_HOME="$HOME" SETUP_DOTFILES_ROOT="$dotfiles_root" SETUP_DRY_RUN=0 \
    "$dotfiles_root/setup.sh" claude "${setup_args[@]}"
fi
[[ ${#skills[@]} -eq 0 ]] || die 2 "Link skills with setup.sh claude --env NAME --skill NAME"
require_command claude
if [[ -z "$env_name" ]]; then
  env_name="$(pick Env "$(env_rows)")"
fi
if [[ "$env_name" = default ]]; then
  config_dir="$HOME/.claude"
else
  validate_name "$env_name"
  config_dir="$envs_root/$env_name"
  env_ready "$config_dir" || die 2 "Environment missing or incomplete: $env_name. Create it with setup.sh claude --env NAME."
fi
check_environment

has_model=0 has_effort=0 has_mcp=0 maintenance=0
for arg in ${claude_args[@]+"${claude_args[@]}"}; do
  case "$arg" in
    --) break ;;
    --model|--model=*) has_model=1 ;;
    --effort|--effort=*) has_effort=1 ;;
    --mcp-config|--mcp-config=*) has_mcp=1 ;;
  esac
done
case "${claude_args[0]:-}" in auth|doctor|update|install|setup-token|mcp|plugin|--help|--version) maintenance=1 ;; esac
if [[ "$maintenance" -eq 1 ]]; then
  [[ -z "$model$effort" ]] || die 2 "Model/effort do not apply to this subcommand"
  model=keep effort=keep
elif [[ -z "$model$effort" ]]; then
  model=keep effort=keep
fi
if [[ "$has_model" -eq 1 ]]; then
  [[ -z "$model" || "$model" = keep ]] || die 2 "Model specified both before and after --"
  model=keep
fi
if [[ "$has_effort" -eq 1 ]]; then
  [[ -z "$effort" || "$effort" = keep ]] || die 2 "Effort specified both before and after --"
  effort=keep
fi
[[ -n "$model" ]] || model="$(pick Model $'keep\tKeep configured model\nopus\tOpus alias\nsonnet\tSonnet alias\nhaiku\tHaiku alias\ndefault\tReset to account default')"
[[ -n "$effort" ]] || effort="$(pick Effort $'keep\tKeep configured effort\nlow\tLow\nmedium\tMedium\nhigh\tHigh\nxhigh\tExtra high\nmax\tMaximum')"
case "$effort" in keep|low|medium|high|xhigh|max) ;; *) die 2 "Invalid effort: $effort" ;; esac
[[ "$model" != -* && "$model" != *$'\n'* && "$model" != *$'\r'* ]] || die 2 "Invalid model"
launch_args=()
[[ "$model" = keep ]] || launch_args+=(--model "$model")
if [[ "$effort" != keep ]]; then
  # This variable outranks --effort. Set it only in the child process to agree.
  export CLAUDE_CODE_EFFORT_LEVEL="$effort"
  launch_args+=(--effort "$effort")
fi
if [[ "$has_mcp" -eq 0 && "$maintenance" -eq 0 ]]; then
  mcp_config="$config_dir/mcp.json"
  if [[ "$env_name" = default ]]; then
    mcp_config="${CLAUDE_MCP_CONFIG:-$dotfiles_root/claude/mcp/base.json}"
  fi
  if [[ -f "$mcp_config" ]]; then launch_args+=(--mcp-config "$mcp_config"); fi
fi
export CLAUDE_CONFIG_DIR="$config_dir" CLAUDE_PICK_ENV="$env_name" CLAUDE_PICK_PROFILE="$env_name"
exec claude ${launch_args[@]+"${launch_args[@]}"} ${claude_args[@]+"${claude_args[@]}"}
