#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: codex-pick [--env ENV] [-q QUERY] [-p PROFILE] [MODEL [EFFORT]] [-- CODEX_ARGS...]

Choose a Codex launch configuration for one invocation.

PROFILE names a PROFILE.config.toml file in the selected Codex home.
ENV selects an independent home; profiles contain model/effort settings only.
Use names such as gpt-6_1-sol_max without an azure_/openai_ prefix.
Legacy provider-prefixed profile names remain supported.
By default, ChatGPT configurations and the generated ~/.codex-azure and
~/.codex-openai and ~/.codex-envs/NAME environments share one picker.
--env overrides CODEX_HOME for the child process. Without --env, an explicit
CODEX_HOME limits selection to that home.
QUERY sets the initial fzf search query for an interactive picker.
MODEL may be a full model slug or an unambiguous slug suffix.
With no arguments, fzf selects either a ChatGPT model/effort combination or a
named profile. An explicitly named profile launches without model overrides.
When MODEL is supplied, a missing EFFORT is selected interactively with fzf.
Arguments after -- are forwarded to codex unchanged.
EOF
}

die() {
  local status="$1"
  shift
  printf 'codex-pick: %s\n' "$*" >&2
  exit "${status}"
}

require_command() {
  local command_name="$1"
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    die 127 "Required command not found: ${command_name}"
  fi
}

valid_env_name() {
  [[ "$1" =~ ^[a-z][a-z0-9_-]{0,63}$ ]] || return 1
  case "$1" in con|prn|aux|nul|com[0-9]|lpt[0-9]) return 1 ;; esac
}

profile_rows() {
  local codex_home="$1"
  local file name target_home label env_name canonical
  local -a files=()

  shopt -s nullglob
  files=("${codex_home}"/*.config.toml)
  shopt -u nullglob

  # Bash 3.2 treats empty arrays as unset under nounset.
  for file in ${files[@]+"${files[@]}"}; do
    [[ -f "${file}" ]] || continue
    name="${file##*/}"
    name="${name%.config.toml}"
    if [[ "${name}" =~ ^[A-Za-z0-9_-]+$ ]]; then
      canonical="$(profile_for_home "${name}" "${codex_home}")"
      [[ "${canonical}" == "${name}" ]] || continue
      target_home="${codex_home}"
      label="Codex profile"
      if [[ -n "${azure_home}" && "${codex_home}" == "${primary_home}" ]] && legacy_azure_profile "${file}"; then
        # Existing dotfiles links remain in the main home during migration.
        canonical="$(profile_for_home "${name}" "${azure_home}")"
        if is_azure_home "${azure_home}" && [[ -f "${azure_home}/${canonical}.config.toml" ]]; then
          continue
        fi
        target_home="${azure_home}"
        label="Azure profile"
      elif is_azure_home "${codex_home}"; then
        label="Azure profile"
      elif is_openai_home "${codex_home}"; then
        label="OpenAI API profile"
      fi
      env_name="$(env_name_for_home "${target_home}")"
      printf '%s/%s\tprofile\t-\t-\t%s\t%s\t%s\t%s\n' "${env_name}" "${name}" "${env_name}" "${name}" "${label}" "${target_home}"
    fi
  done
}

is_azure_home() {
  [[ -f "$1/config.toml" ]] && { [[ "$(managed_provider "$1")" == azure ]] || [[ ! -e "$1/.dotfiles-env.json" && -f "$1/.dotfiles-azure.json" ]]; }
}

is_openai_home() {
  [[ -f "$1/config.toml" ]] && { [[ "$(managed_provider "$1")" == openai ]] || [[ ! -e "$1/.dotfiles-env.json" && -f "$1/.dotfiles-openai.json" ]]; }
}

env_name_for_home() {
  case "$1" in
    "${HOME}/.codex") printf 'default\n' ;;
    "${HOME}/.codex-azure") printf 'azure\n' ;;
    "${HOME}/.codex-openai") printf 'openai\n' ;;
    "${HOME}/.codex-envs/"*) printf '%s\n' "${1##*/}" ;;
    *) printf 'current\n' ;;
  esac
}

managed_provider() {
  [[ -f "$1/.dotfiles-env.json" && ! -L "$1" && ! -L "$1/.dotfiles-env.json" ]] || return 1
  require_command jq
  jq -er --arg name "$(env_name_for_home "$1")" '
    select(.version == 3 and (.env | type == "string") and (.env | test("^[a-z][a-z0-9_-]{0,63}$")) and (.env == $name or $name == "current"))
    | .provider | select(. == "azure" or . == "openai" or . == "chatgpt")
  ' "$1/.dotfiles-env.json" 2>/dev/null
}

require_env_home() {
  if [[ "$1" == "${HOME}/.codex-envs/"* && -L "${HOME}/.codex-envs" ]]; then die 2 "Environment directory must not be a symlink"; fi
  [[ -d "$1" && ! -L "$1" && -f "$1/config.toml" ]] || die 2 "Environment is missing or incomplete: $1. Run ./setup.sh codex --env NAME first"
  if [[ "$(env_name_for_home "$1")" != default ]] && ! is_api_home "$1" && [[ "$(managed_provider "$1")" != chatgpt ]]; then
    die 2 "Environment is missing or incomplete: $1. Run ./setup.sh codex --env NAME first"
  fi
  if [[ "$(env_name_for_home "$1")" != default && -L "$1/config.toml" ]]; then die 2 "Environment config must not be a symlink: $1"; fi
}

profile_for_home() {
  local name="$1" home="$2" kind
  if [[ -f "${home}/.dotfiles-env.json" ]]; then
    kind="$(managed_provider "${home}")" || die 2 "Invalid environment metadata: ${home}"
    if [[ "${name}" == "${kind}_"* ]]; then
      name="${name#"${kind}_"}"
    fi
  fi
  printf '%s\n' "${name}"
}

is_api_home() {
  is_azure_home "$1" || is_openai_home "$1"
}

legacy_azure_profile() {
  local file="$1"
  [[ -L "${file}" ]] || return 1
  [[ "$(readlink "${file}")" == */codex/azure_*.config.toml ]]
}

require_azure_home() {
  if ! is_azure_home "$1"; then
    die 2 "Azure home is not ready: $1. Run ./setup.sh codex first"
  fi
}

require_openai_home() {
  if ! is_openai_home "$1"; then
    die 2 "OpenAI home is not ready: $1. Run ./setup.sh codex --provider openai first"
  fi
}

resolve_profile() {
  local profile="$1"
  local main_file="${primary_home}/${profile}.config.toml"
  local candidate_home selected_home=""

  if [[ ! "${profile}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    die 2 "Invalid profile name: ${profile}. Use letters, numbers, hyphens, or underscores"
  fi

  if [[ -n "${azure_home}" ]]; then
    if legacy_azure_profile "${main_file}"; then
      require_azure_home "${azure_home}"
      validate_profile "$(profile_for_home "${profile}" "${azure_home}")" "${azure_home}"
      printf '%s\n' "${azure_home}"
      return
    fi
  fi

  if [[ ( -n "${env_query}" || ( -n "${CODEX_HOME:-}" && -f "${primary_home}/.dotfiles-env.json" ) ) && ( "${profile}" == azure_* || "${profile}" == openai_* ) ]]; then
    local kind
    kind="$(managed_provider "${primary_home}")" || {
      if is_azure_home "${primary_home}"; then kind=azure; elif is_openai_home "${primary_home}"; then kind=openai; else kind=chatgpt; fi
    }
    [[ "${profile}" == "${kind}_"* ]] || die 2 "Legacy profile provider does not match the selected environment"
  fi

  for candidate_home in ${candidate_homes[@]+"${candidate_homes[@]}"}; do
    [[ -n "${candidate_home}" ]] || continue
    if [[ "${candidate_home}" != "${primary_home}" ]] && ! is_api_home "${candidate_home}" && [[ "$(managed_provider "${candidate_home}")" != chatgpt ]]; then
      continue
    fi
    local candidate_profile
    candidate_profile="$(profile_for_home "${profile}" "${candidate_home}")"
    [[ -f "${candidate_home}/${candidate_profile}.config.toml" ]] || continue
    if [[ -n "${selected_home}" ]]; then
      die 2 "Ambiguous profile: ${profile}. Use --env NAME or CODEX_HOME to select its environment"
    fi
    selected_home="${candidate_home}"
  done
  if [[ -z "${selected_home}" ]]; then
    validate_profile "$(profile_for_home "${profile}" "${primary_home}")" "${primary_home}"
  fi
  printf '%s\n' "${selected_home}"
}

launch_codex() {
  local target_home="$1"
  shift
  if [[ -n "${azure_home}" && "${target_home}" == "${azure_home}" ]]; then
    require_azure_home "${target_home}"
  elif [[ -n "${openai_home}" && "${target_home}" == "${openai_home}" ]]; then
    require_openai_home "${target_home}"
  fi
  if [[ -e "${target_home}/.dotfiles-env.json" ]]; then require_env_home "${target_home}"; fi
  exec env CODEX_HOME="${target_home}" CODEX_PICK_ENV="$(env_name_for_home "${target_home}")" codex "$@"
}

chatgpt_rows() {
  local catalog="$1"
  local codex_home="$2" env_name
  env_name="$(env_name_for_home "${codex_home}")"

  jq -r --arg env "${env_name}" --arg home "${codex_home}" '
    .models[]
    | select(
        .visibility == "list"
        and (
          .slug == "gpt-5.6"
          or (.slug | startswith("gpt-5.6-"))
          or .slug == "gpt-6-astra"
          or .slug == "gpt-5.3-codex-spark"
        )
      ) as $model
    | $model.supported_reasoning_levels[]
    | [
        ($env + "/" + $model.slug + "_" + .effort),
        "chatgpt",
        $model.slug,
        .effort,
        $env,
        $model.display_name,
        .description,
        $home
      ]
    | @tsv
  ' <<< "${catalog}"
}

validate_profile() {
  local profile="$1"
  local codex_home="$2"

  if [[ ! "${profile}" =~ ^[A-Za-z0-9_-]+$ ]]; then
    die 2 "Invalid profile name: ${profile}. Use letters, numbers, hyphens, or underscores"
  fi

  if [[ ! -f "${codex_home}/${profile}.config.toml" ]]; then
    die 2 "Profile not found: ${profile} (${codex_home}/${profile}.config.toml)"
  fi
}

configuration_rows() {
  local catalog="$1"
  local codex_home="$2"

  profile_rows "${codex_home}"
  if [[ -n "${azure_home}" ]] && is_azure_home "${azure_home}"; then
    profile_rows "${azure_home}"
  fi
  if [[ -n "${openai_home}" ]] && is_openai_home "${openai_home}"; then
    profile_rows "${openai_home}"
  fi
  if [[ -n "${catalog}" ]]; then
    chatgpt_rows "${catalog}" "${codex_home}"
  fi
  local home extra_catalog
  for home in ${extra_homes[@]+"${extra_homes[@]}"}; do
    profile_rows "${home}"
    if [[ "$(managed_provider "${home}")" == chatgpt ]]; then
      extra_catalog="$(load_catalog "${home}")"
      chatgpt_rows "${extra_catalog}" "${home}"
    fi
  done
}

pick_configuration() {
  local catalog="$1"
  local codex_home="$2"
  local initial_query="$3"
  local rows
  local selected

  rows="$(configuration_rows "${catalog}" "${codex_home}")"
  [[ -n "${rows}" ]] || die 2 "No configurations found in ${codex_home}"

  selected="$(
    printf '%s\n' "${rows}" |
      fzf --delimiter=$'\t' --with-nth=5,6,7 --prompt='Env / Profile> ' \
        --query="${initial_query}"
  )" || return $?

  printf '%s\n' "${selected}"
}

load_catalog() {
  local catalog
  local home="${1:-${primary_home}}"

  if catalog="$(env CODEX_HOME="${home}" codex debug models 2>/dev/null)" &&
    jq -e '
      (.models | type == "array")
      and ([.models[] | select(.visibility == "list")] | length > 0)
    ' >/dev/null 2>&1 <<< "${catalog}"; then
    printf '%s\n' "${catalog}"
    return 0
  fi

  if catalog="$(env CODEX_HOME="${home}" codex debug models --bundled 2>/dev/null)" &&
    jq -e '
      (.models | type == "array")
      and ([.models[] | select(.visibility == "list")] | length > 0)
    ' >/dev/null 2>&1 <<< "${catalog}"; then
    printf '%s\n' "${catalog}"
    return 0
  fi

  die 1 "Unable to read the Codex model catalog; codex debug models is required"
}

visible_model_list() {
  local catalog="$1"
  jq -r '[.models[] | select(.visibility == "list") | .slug] | join(", ")' <<< "${catalog}"
}

resolve_model() {
  local query="$1"
  local catalog="$2"
  local exact match
  local -a matches=()

  exact="$(
    jq -r --arg query "${query}" \
      'first(.models[] | select(.visibility == "list" and .slug == $query) | .slug) // empty' \
      <<< "${catalog}"
  )"
  if [[ -n "${exact}" ]]; then
    printf '%s\n' "${exact}"
    return 0
  fi

  while IFS= read -r match; do
    matches+=("${match}")
  done < <(
    jq -r --arg query "${query}" \
      '.models[] | select(.visibility == "list" and (.slug | endswith("-" + $query))) | .slug' \
      <<< "${catalog}"
  )

  case "${#matches[@]}" in
    0)
      die 2 "Unknown model: ${query}. Available models: $(visible_model_list "${catalog}")"
      ;;
    1)
      printf '%s\n' "${matches[0]}"
      ;;
    *)
      die 2 "Ambiguous model: ${query}. Matches: ${matches[*]}"
      ;;
  esac
}

effort_list() {
  local model="$1"
  local catalog="$2"
  jq -r --arg model "${model}" '
    [.models[]
      | select(.slug == $model)
      | .supported_reasoning_levels[].effort]
    | join(", ")
  ' <<< "${catalog}"
}

validate_effort() {
  local model="$1"
  local effort="$2"
  local catalog="$3"

  if ! jq -e --arg model "${model}" --arg effort "${effort}" '
    [.models[]
      | select(.slug == $model)
      | .supported_reasoning_levels[]
      | select(.effort == $effort)]
    | length == 1
  ' >/dev/null <<< "${catalog}"; then
    die 2 "Unsupported effort for ${model}: ${effort}. Valid efforts: $(effort_list "${model}" "${catalog}")"
  fi
}

pick_effort() {
  local model="$1"
  local catalog="$2"
  local initial_query="$3"
  local rows selected

  rows="$(
    jq -r --arg model "${model}" '
      .models[]
      | select(.slug == $model) as $selected_model
      | $selected_model.supported_reasoning_levels[]
      | [
          .effort,
          .description,
          (if .effort == $selected_model.default_reasoning_level then "default" else "" end)
        ]
      | @tsv
    ' <<< "${catalog}"
  )"

  selected="$(
    printf '%s\n' "${rows}" |
      fzf --delimiter=$'\t' --with-nth=1,2,3 --prompt='Effort> ' \
        --query="${initial_query}"
  )" || return $?

  printf '%s\n' "${selected%%$'\t'*}"
}

profile_query=""
env_query=""
profile_requested=0
initial_query=""
model_query=""
effort_query=""
declare -a positionals=()
declare -a codex_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -p | --profile)
      if [[ $# -lt 2 || -z "$2" ]]; then
        die 2 "$1 requires a profile name"
      fi
      profile_query="$2"
      profile_requested=1
      shift 2
      ;;
    --env)
      [[ $# -ge 2 && -n "$2" && "$2" != -* ]] || die 2 "--env requires an environment name"
      [[ -z "${env_query}" || "${env_query}" == "$2" ]] || die 2 "Environment specified twice with different names"
      env_query="$2"
      shift 2
      ;;
    --env=*)
      env_value="${1#--env=}"
      [[ -n "${env_value}" ]] || die 2 "--env requires an environment name"
      [[ -z "${env_query}" || "${env_query}" == "${env_value}" ]] || die 2 "Environment specified twice with different names"
      env_query="${env_value}"
      shift
      ;;
    -q | --query)
      if [[ $# -lt 2 ]]; then
        die 2 "$1 requires a query"
      fi
      initial_query="$2"
      shift 2
      ;;
    --query=*)
      initial_query="${1#--query=}"
      shift
      ;;
    --profile=*)
      profile_query="${1#--profile=}"
      if [[ -z "${profile_query}" ]]; then
        die 2 "--profile requires a profile name"
      fi
      profile_requested=1
      shift
      ;;
    --)
      shift
      codex_args=("$@")
      break
      ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

if [[ "${#positionals[@]}" -gt 2 ]]; then
  die 2 "Unexpected argument: ${positionals[2]}. Place Codex arguments after --"
fi

model_query="${positionals[0]:-}"
effort_query="${positionals[1]:-}"
codex_home="${CODEX_HOME:-${HOME}/.codex}"
primary_home="${codex_home}"
azure_home=""
openai_home=""
extra_homes=()
if [[ -n "${env_query}" ]]; then
  valid_env_name "${env_query}" || die 2 "Invalid or reserved environment name"
  case "${env_query}" in
    default) codex_home="${HOME}/.codex" ;;
    azure|openai) codex_home="${HOME}/.codex-${env_query}" ;;
    *) codex_home="${HOME}/.codex-envs/${env_query}" ;;
  esac
  require_env_home "${codex_home}"
  primary_home="${codex_home}"
elif [[ -z "${CODEX_HOME:-}" ]]; then
  azure_home="${HOME}/.codex-azure"
  openai_home="${HOME}/.codex-openai"
  for env_home in "${HOME}/.codex-envs/"*; do
    [[ ! -L "${HOME}/.codex-envs" ]] || break
    [[ -d "${env_home}" && ! -L "${env_home}" && -f "${env_home}/config.toml" && ! -L "${env_home}/config.toml" ]] || continue
    env_name="${env_home##*/}"
    valid_env_name "${env_name}" || continue
    [[ "${env_name}" != default && "${env_name}" != azure && "${env_name}" != openai ]] || continue
    if managed_provider "${env_home}" >/dev/null; then extra_homes+=("${env_home}"); fi
  done
fi
candidate_homes=("${primary_home}")
[[ -z "${azure_home}" ]] || candidate_homes+=("${azure_home}")
[[ -z "${openai_home}" ]] || candidate_homes+=("${openai_home}")
candidate_homes+=(${extra_homes[@]+"${extra_homes[@]}"})

require_command codex

profile=""
if [[ "${profile_requested}" -eq 1 ]]; then
  codex_home="$(resolve_profile "${profile_query}")"
  profile="$(profile_for_home "${profile_query}" "${codex_home}")"
fi

if [[ -n "${profile}" && -z "${model_query}" ]]; then
  launch_codex "${codex_home}" --profile "${profile}" ${codex_args[@]+"${codex_args[@]}"}
fi

catalog=""
if [[ -n "${model_query}" ]] || ! is_api_home "${primary_home}"; then
  require_command jq
  catalog="$(load_catalog "${codex_home}")"
fi

if [[ -z "${model_query}" ]]; then
  require_command fzf
  configuration="$(pick_configuration "${catalog}" "${codex_home}" "${initial_query}")" || exit $?
  IFS=$'\t' read -r configuration_name configuration_kind model effort _ _ _ target_home <<< "${configuration}"
  codex_home="${target_home}"

  if [[ "${configuration_kind}" == "profile" ]]; then
    configuration_name="${configuration_name#*/}"
    if [[ -n "${azure_home}" && "${target_home}" == "${azure_home}" ]]; then
      require_azure_home "${target_home}"
    fi
    validate_profile "${configuration_name}" "${target_home}"
    launch_codex "${target_home}" --profile "${configuration_name}" ${codex_args[@]+"${codex_args[@]}"}
  fi
else
  model="$(resolve_model "${model_query}" "${catalog}")"

  if [[ -n "${effort_query}" ]]; then
    effort="${effort_query}"
    validate_effort "${model}" "${effort}" "${catalog}"
  else
    require_command fzf
    effort="$(pick_effort "${model}" "${catalog}" "${initial_query}")" || exit $?
  fi
fi

declare -a profile_args=()
if [[ -n "${profile}" ]]; then
  profile_args=(--profile "${profile}")
fi

launch_codex "${codex_home}" \
  ${profile_args[@]+"${profile_args[@]}"} \
  -m "${model}" \
  -c "model_reasoning_effort='${effort}'" \
  ${codex_args[@]+"${codex_args[@]}"}
